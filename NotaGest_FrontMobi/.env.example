# Perfil de Ambiente ativo: 'dev' (local/emulador) | 'prod' (nuvem)
# Para detalhes sobre a arquitetura do Profile Switcher, consulte: docs/ADR_003_ESTRATEGIA_DE_AMBIENTES_E_PROFILE_SWITCHER.md
EXPO_PUBLIC_APP_ENV=dev

# Override manual da API (opcional). Se vazio, a URL e resolvida automaticamente pelo profile ativo.
